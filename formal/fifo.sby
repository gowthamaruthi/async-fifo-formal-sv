[tasks]
prove
bmc
cover

[options]
prove: mode prove
prove: depth 12
bmc: mode bmc
bmc: depth 22
cover: mode cover
cover: depth 80
multiclock on
timeout 600

[engines]
smtbmc z3

[script]
prove: read -formal -D LOCAL_ONLY async_fifo.sv harness.sv
bmc: read -formal async_fifo.sv harness.sv
cover: read -formal async_fifo.sv harness.sv
prep -top harness

[files]
rtl/async_fifo.sv
formal/harness.sv
formal/properties.svh
